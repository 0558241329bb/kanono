# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# عنوان التطبيق العام (روابط، OAuth، إعادة توجيه Google على Firebase)
# الإنتاج الحالي على Render:
APP_URL=https://kanono-u1wb.onrender.com

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=lgs
DATABASE_URL=
JWT_SECRET="YOUR_JWT_SECRET"
# بريد إضافي يرقّى تلقائياً لأدمن (اختياري، مفصولة بفواصل)
# ADMIN_EMAILS=other@example.com
PORT=3000

# واجهة Vite: جذر الخدمة (يُضاف /api تلقائياً في الكود إن لزم)
# تطوير محلي: اتركها فارغة → يُستخدم /api مع الخادم المحلي
# Render: عيّنها في لوحة الخدمة (انظر render.yaml) أو اعتمد على القيمة الافتراضية في src/config/deploy.ts
# VITE_API_URL=https://kanono-u1wb.onrender.com
VITE_API_URL=https://kanono-u1wb.onrender.com/

# Firebase Admin على الخادم (تسجيل الدخول بـ Google عبر idToken)
FIREBASE_PROJECT_ID=avocatdz-d6161

# Firebase Console → Authentication → Authorized domains: أضف kanono-u1wb.onrender.com
# Google Cloud Console → OAuth → Authorized redirect URIs: نفس النطاق إن لزم
